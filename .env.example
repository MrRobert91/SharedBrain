# Ruta a tu vault de Obsidian en el host (para docker compose)
VAULT_PATH=C:/Users/tu-usuario/Documentos/MiVault

# Claves de API (solo las del proveedor que uses en SHAREDBRAIN_MODEL)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Modelo en formato pydantic-ai: <proveedor>:<modelo>
#   anthropic:claude-fable-5
#   openai:gpt-5.2
#   openrouter:anthropic/claude-sonnet-4.6   (cualquier modelo de openrouter.ai/models)
SHAREDBRAIN_MODEL=anthropic:claude-fable-5
# Modelo barato opcional para tareas menores
SHAREDBRAIN_MODEL_CHEAP=

# Token de GitHub: clonar/sincronizar el vault si su repo es privado,
# y leer repos privados en project-sync (scope: repo)
GITHUB_TOKEN=

# Repo git del vault (owner/repo o URL). Si se define, el contenedor lo clona
# en /vault en el primer arranque y "vault sync" lo mantiene al día.
SHAREDBRAIN_VAULT_REPO=
SHAREDBRAIN_VAULT_BRANCH=

# Si se define, panel + API + MCP exigen Basic Auth con esta contraseña.
# OBLIGATORIO en despliegues expuestos a internet (Sliplane, VPS...).
SHAREDBRAIN_PASSWORD=
